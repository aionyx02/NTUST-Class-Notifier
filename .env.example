# ============================================================
#  NTUST-Class-Notifier 設定檔
#  用法：cp .env.example .env，再改你需要的那幾行
#  只有 LOOK_UP_CLASSES 一定要填，其餘留空 = 不啟用該功能
# ============================================================


# ------------------------------------------------------------
#  1. 要監控哪些課                                     （必填）
# ------------------------------------------------------------
#  寫法：欄位:值
#    空白 = 而且     課號:CS 學制:大學部   -> CS 開頭「而且」大學部
#    分號 = 或者     課號:CS; 課號:EE21    -> CS 開頭「或」EE21 開頭
#    逗號 = 任一     課號:CS,EE21          -> 同上，寫成同一條規則
#    沒寫的欄位     = 不限制
#
#  可以填的欄位：
#
#    欄位      可以放什麼                          範例
#    --------  ---------------------------------   ----------------------
#    課號      課號的「開頭」，不分大小寫          課號:CS1003301
#    課名      課名的「一部分」                    課名:程式設計
#    老師      老師姓名的「一部分」                老師:姚
#    學制      大學部 / 研究所 / 通識              學制:大學部
#    系所      你的系級，擋掉別系的假空位          系所:資訊工程系三
#    只看空位  是 / 否（預設 否）                  只看空位:是
#    學期      四碼學期代碼（預設自動抓最新）      學期:1151
#
#    英文別名同樣可用：code / name / teacher / level / dept / vacant / semester
#
LOOK_UP_CLASSES=課號:CS 學制:大學部; 課號:PE139A053 系所:資訊工程系三

#  想一行寫一條規則就用編號變數，程式會自動合併。
#  （同一個變數名寫兩行只有最後一行有效，所以才要換名字）
#LOOK_UP_CLASSES_1=課號:EE 學制:大學部
#LOOK_UP_CLASSES_2=課名:體育 只看空位:是


# ------------------------------------------------------------
#  2. Discord 通知                                     （選填）
# ------------------------------------------------------------
#  兩個都填才會發通知，只有 ntust-notify 用得到。
#
#    變數                 可以放什麼
#    -------------------  --------------------------------------------
#    DISCORD_BOT_TOKEN    Discord Developer Portal 產生的 Bot Token
#    DISCORD_TARGET_IDS   收通知的 ID，多個用 ; 分隔；程式自動判斷：
#                           伺服器 ID -> 自動挑一個發得了言的文字頻道
#                           頻道 ID   -> 發到那個頻道
#                           使用者 ID -> 發私訊
#
#  ID 怎麼拿：Discord 設定 -> 進階 -> 開啟「開發者模式」，
#             再對伺服器 / 頻道 / 頭像按右鍵 -> 複製 ID
DISCORD_BOT_TOKEN=
DISCORD_TARGET_IDS=


# ------------------------------------------------------------
#  3. 選課系統帳密                         （選填，不建議填）
# ------------------------------------------------------------
#  兩個都填時，ntust-notify 會在電選課加選期間偵測到空位就自動送出加選。
#  自動加選有被學校盯上的風險，不確定後果就請留空。
#  ntust-watch 與 ntust-alert 永遠不會登入選課系統。
STUDENT_ID=
PASSWORD=


# ------------------------------------------------------------
#  4. 其他                                             （選填）
# ------------------------------------------------------------
#    變數            可以放什麼
#    --------------  ------------------------------------------
#    NTUST_DATA_DIR  cookie 等執行期檔案的存放目錄
#                    （預設 ~/.ntust-class-notifier）
#    NO_COLOR        設任何值就停用終端機色彩（等同 --no-color）
#NTUST_DATA_DIR=
#NO_COLOR=
